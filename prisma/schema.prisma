// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// never use the migrate command. always do the db push 
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FARMER
  BEGINNER
  GARDENER
  STUDENT
  OTHER
}

// SELF NOTE (VERY IMPORTANT): whenever an enum is added, it should also be added to the "detectedCropEnum" field in the detectionResultSchema
enum CropType {
  MAIZE
  TOMATO
  CASSAVA
  PLANTAIN
  PEPPER
  COCOA
  RICE
  YAM
  GROUNDNUT
  ONION
  FREE
}

enum CropStatus {
  HEALTHY
  MONITORING
  AT_RISK
  HARVEST_READY
}

enum NotificationType {
  DAILY_SUMMARY
  HIGH_RISK
  CROP_SPECIFIC
  FAVORABLE_CONDITION
  GENERAL_ADVICE
  POST_LIKED
  POST_COMMENTED
  COMMENT_REPLIED
  USER_FOLLOWED
  FOLLOWED_USER_POSTED
  COMMENT_MARKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum CommentMarkType {
  HELPFUL
  SOLVED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SubscriptionSource {
  DEMO
  PAYSTACK
  MANUAL
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  role            UserRole @default(OTHER)
  phoneNumber     String   @unique
  isOnboarded     Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  language        String   @default("en") // For Twi support later

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  profile            Profile?
  detections         Detection[]
  userPreferredCrops UserPreferredCrop[]
  weatherRequests    WeatherRequest[]
  notifications      Notification[]

  cachedDiagnoses CachedDiagnosis[]

  passwordResetOTPs PasswordResetOTP[]
  pushTokens        PushToken[]

  posts           Post[]
  comments        Comment[]
  postLikes       PostLike[]
  savedPosts      SavedPost[]
  followers       Follow[]             @relation("UserFollowers")
  following       Follow[]             @relation("UserFollowing")
  tagFollows      TagFollow[]
  commentMarks    CommentMark[]
  tipServings     UserTipServing[]
  dailyTipsCaches UserDailyTipsCache[]
  subscriptions   UserSubscription[]

  @@index([email])
  @@map("users")
}

// Profile model (one-to-one with User)
model Profile {
  id             String     @id @default(cuid())
  userId         String     @unique
  fullName       String
  avatarUrl      String?
  location       Json? // { latitude, longitude, address, accuracy? } - Auto-detected from frontend GPS
  preferredCrops CropType[]

  bio                 String?
  communityRegion     String? // one of the 16 Ghana regions
  reputationScore     Int     @default(0)
  helpfulAnswersCount Int     @default(0)
  solvedAnswersCount  Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// For future scalability (User <-> CropType)
model UserPreferredCrop {
  userId              String
  cropType            CropType
  // Custom name for ownership feeling (e.g., "My Backyard Maize")
  customName          String?
  plantingDate        DateTime?
  expectedHarvestDate DateTime?
  farmSize            Decimal?
  farmSizeUnit        String?    @default("acres")
  notes               String?
  status              CropStatus @default(HEALTHY)
  // For easy sorting of recently active crops
  lastActivityDate    DateTime?  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, cropType])
  @@map("user_preferred_crops")
}

model Detection {
  id                String   @id @default(cuid())
  imageUrl          String?
  cropType          CropType
  rawResponse       Json // Store full AI response for debugging/auditing
  diseaseName       String
  confidence        Float    @default(0.0)
  possibleDiseases  Json? // Array of possible diseases with scores
  symptoms          String?
  causes            String?
  organicTreatments String?
  chemicalOptions   String?
  prevention        String?
  localNotes        String? // Ghana/Twi specific recommendations
  aiProvider        String?  @default("gemini")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  cachedDiagnosisId String?
  cachedDiagnosis   CachedDiagnosis? @relation(fields: [cachedDiagnosisId], references: [id])
  posts             Post[]

  @@index([cropType])
  @@index([createdAt])
  @@index([userId])
  @@map("detections")
}

model CachedDiagnosis {
  id                  String   @id @default(cuid())
  imageHash           String
  cropType            CropType
  language            String   @default("en")
  result              Json // Full structured diagnosis result
  expiresAt           DateTime
  imagePerceptualHash String?
  diseaseName         String?
  confidence          Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  detections Detection[]

  @@unique([imageHash, language])
  @@index([imageHash])
  @@index([cropType, language])
  @@index([expiresAt])
  @@index([diseaseName, cropType, language])
  @@index([imagePerceptualHash])
  @@map("cached_diagnoses")
}

model WeatherRequest {
  id          String  @id @default(cuid())
  userId      String?
  latitude    Float
  longitude   Float
  cropType    String? // Optional specific crop being checked
  rawData     Json // Full Open-Meteo response
  riskSummary Json? // Computed disease risk insights

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("weather_requests")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  priority   Priority         @default(MEDIUM)
  isRead     Boolean          @default(false)
  expiresAt  DateTime? //  For auto-cleanup of old alerts
  actionLink String? //  e.g. "/weather" or deep link
  metadata   Json? // Extra context (weather, crops, etc.)

  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([sentAt])
  @@index([priority])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // The Expo push token itself - unique so re-registering the same device just updates its row
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model PasswordResetOTP {
  id        String   @id @default(cuid())
  userId    String
  otpHash   String // NEVER store the raw OTP, only its bcrypt hash
  expiresAt DateTime // OTP is valid for 10 minutes from creation
  isUsed    Boolean  @default(false) // prevents replay/reuse after a successful reset

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_otps")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  posts      PostTag[]
  tagFollows TagFollow[]

  @@map("tags")
}

model Post {
  id          String    @id @default(cuid())
  userId      String
  content     String
  imageUrls   String[] // max 3 images (enforced in service)
  region      String? // one of the 16 Ghana regions
  cropType    CropType?
  detectionId String? // optional link to a Detection

  likesCount    Int @default(0)
  commentsCount Int @default(0)
  savesCount    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  detection Detection?  @relation(fields: [detectionId], references: [id], onDelete: SetNull)
  tags      PostTag[]
  comments  Comment[]
  likes     PostLike[]
  saves     SavedPost[]

  @@index([userId])
  @@index([createdAt])
  @@index([region])
  @@index([cropType])
  @@index([likesCount])
  @@map("posts")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Comment {
  id           String  @id @default(cuid())
  postId       String
  userId       String
  parentId     String? // null = top-level comment, set = reply (one level only)
  content      String
  helpfulCount Int     @default(0)
  solvedCount  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("CommentReplies")
  marks   CommentMark[]

  @@index([postId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

model PostLike {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("post_likes")
}

model SavedPost {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("saved_posts")
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("follows")
}

model TagFollow {
  userId    String
  tagId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@map("tag_follows")
}

model CommentMark {
  id        String          @id @default(cuid())
  userId    String
  commentId String
  type      CommentMarkType
  createdAt DateTime        @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId, type])
  @@index([commentId])
  @@map("comment_marks")
}

model DailyTip {
  id        String     @id @default(cuid())
  title     String
  body      String
  // empty array = general (applies to any crop)
  cropTypes CropType[]
  // empty = nationwide; values should match GHANA_REGIONS strings
  regions   String[]
  // 1–12; empty = any month
  months    Int[]
  // free-form themes for matching recent detections e.g. "fungal", "drainage", "prevention", "rust"
  themes    String[]
  weight    Int        @default(1)
  isActive  Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servings UserTipServing[]

  @@index([isActive])
  @@map("daily_tips")
}

model UserTipServing {
  id       String   @id @default(cuid())
  userId   String
  tipId    String
  date     String
  servedAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tip  DailyTip @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([userId, tipId, date])
  @@index([userId, servedAt])
  @@index([userId, tipId])
  @@map("user_tip_servings")
}

model UserDailyTipsCache {
  id       String   @id @default(cuid())
  userId   String
  // YYYY-MM-DD in Africa/Accra
  date     String
  // final payload returned by API (personalized titles/bodies + order)
  tipsJson Json
  tipIds   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("user_daily_tips_cache")
}

model SubscriptionPlan {
  id              String  @id @default(cuid())
  code            String  @unique // FREE | FARMER_MONTHLY
  name            String
  priceGhs        Decimal @default(0) // 50 for Farmer; Paystack amount = priceGhs * 100 (pesewas)
  durationDays    Int     @default(30) // informational; real end date uses same-day-next-month logic
  scanLimit       Int? // null = unlimited (paid); 5 for FREE
  hasCropInsights Boolean @default(false)
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id          String             @id @default(cuid())
  userId      String
  planId      String
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime
  endsAt      DateTime
  source      SubscriptionSource @default(DEMO)
  externalRef String? // future Paystack reference
  amountGhs   Decimal? // stored amount at activation (e.g. 50)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([endsAt])
  @@map("user_subscriptions")
}
